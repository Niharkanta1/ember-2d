package @PACKAGE@;

import com.badlogic.gdx.Application;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.graphics.g2d.BitmapFont;
import com.badlogic.gdx.math.Interpolation;
import com.badlogic.gdx.scenes.scene2d.ui.Label;
import dev.ember2d.app.EngineContext;
import dev.ember2d.app.Scene;
import dev.ember2d.ecs.Transform;
import dev.ember2d.ecs.World;
import dev.ember2d.input.Input;
import dev.ember2d.render.SpriteRenderSystem;
import dev.ember2d.render.Text;
import dev.ember2d.render.TextAlign;
import dev.ember2d.render.TextRenderer;
import dev.ember2d.ui.Ui;
import dev.ember2d.ui.UiSkins;

/** The first scene: the title in the world, gently bobbing, and a hint. Escape (Back on Android) quits. */
final class MainScene extends Scene {

    private Input input;
    private Text title;

    @Override
    protected void enter(EngineContext context) {
        input = context.input();
        World world = world();
        SpriteRenderSystem sprites = new SpriteRenderSystem(world, context.renderer(), context.assets(), context.time());
        world.addSystem(sprites);
        new TextRenderer(world, context.renderer(), context.assets(), context.time()).attachTo(sprites);

        int entity = world.create();
        Transform transform = world.add(entity, new Transform());
        transform.teleport(context.renderer().camera().position.x, context.renderer().camera().position.y);
        title = world.add(entity, new Text());
        title.font = "font.pixel";
        title.text = "@TITLE@";
        title.align = TextAlign.CENTER;
        bob(true);

        Ui ui = ui();
        ui.setSkin(UiSkins.pixel(context.assets().get("font.pixel", BitmapFont.class)), true);   // before any widget
        ui.root().bottom();
        boolean android = Gdx.app.getType() == Application.ApplicationType.Android;
        String hint = (android ? "Back" : "Esc") + " to quit   v" + @GAME@.version();
        ui.root().add(new Label(hint, ui.skin())).padBottom(8f);
    }

    /** Moves the title up and down forever with a tween. */
    private void bob(boolean up) {
        tweens().to(() -> title.offset.y, y -> title.offset.y = y, up ? 0.25f : -0.25f, 1.2f, Interpolation.sine)
                .then(() -> bob(!up));
    }

    @Override
    protected void update(float delta) {
        if (input.justPressed("quit")) {
            Gdx.app.exit();
        }
    }
}
