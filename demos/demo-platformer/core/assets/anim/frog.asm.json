{
 "version": 1,
 "clipSet": "anim.frog",
 "parameters": {
  "grounded": "bool",
  "speedX": "float",
  "velY": "float",
  "hit": "trigger"
 },
 "initial": "idle",
 "states": {
  "idle": {
   "clip": "idle"
  },
  "run": {
   "clip": "run",
   "speed": 0.125,
   "speedParam": "speedX"
  },
  "jump": {
   "clip": "jump"
  },
  "fall": {
   "clip": "fall"
  },
  "hit": {
   "clip": "hit",
   "exitOnFinish": true
  }
 },
 "transitions": [
  {
   "from": "*",
   "to": "hit",
   "when": "hit",
   "priority": 10
  },
  {
   "from": "idle",
   "to": "run",
   "when": "grounded && speedX > 0.5"
  },
  {
   "from": "run",
   "to": "idle",
   "when": "grounded && speedX <= 0.5"
  },
  {
   "from": "*",
   "to": "jump",
   "when": "!grounded && velY > 0"
  },
  {
   "from": "*",
   "to": "fall",
   "when": "!grounded && velY <= 0"
  },
  {
   "from": "jump",
   "to": "idle",
   "when": "grounded"
  },
  {
   "from": "fall",
   "to": "idle",
   "when": "grounded"
  }
 ]
}
