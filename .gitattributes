# Normalise text files to LF in the repository; checkout follows the platform.
* text=auto

# Scripts that must keep a fixed line ending regardless of platform.
gradlew      text eol=lf
*.sh         text eol=lf
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary files.
*.jar        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.ogg        binary
*.wav        binary
*.mp3        binary
*.ttf        binary
*.otf        binary
*.aseprite   binary
*.ase        binary
*.keystore   binary
*.jks        binary
